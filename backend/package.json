{
  "name": "backend",
  "version": "1.1.4",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "npm run dev:server",
    "dev:server": "tsx watch --clear-screen=false src/server.ts",
    "build": "npm run clean:build && npm run admin:build && npm run build:ts",
    "clean:build": "node scripts/clean-build.cjs",
    "admin:build": "react-router build",
    "admin:typecheck": "react-router typegen && tsc --noEmit -p tsconfig.admin.json",
    "build:ts": "tsc && tsc-alias",
    "tscheck": "npm run admin:typecheck && tsc --noEmit",
    "db": "node scripts/db.cjs",
    "lint": "biome check src e2e scripts/clean-build.cjs scripts/e2e.cjs drizzle.config.ts",
    "lint-fix": "biome check --write src e2e scripts/clean-build.cjs scripts/e2e.cjs drizzle.config.ts",
    "test:e2e": "node scripts/e2e.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@mantine/core": "^9.6.2",
    "@react-router/express": "^8.4.0",
    "@react-router/node": "^8.4.0",
    "@types/connect-pg-simple": "^7.0.3",
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.18.2",
    "isbot": "^5",
    "pg": "^8.21.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.62.0",
    "react-router": "^8.4.0",
    "sharp": "^0.35.3",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.4.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2",
    "vite": "^8.3.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "biome check --write --no-errors-on-unmatched",
      "biome check --error-on-warnings --no-errors-on-unmatched"
    ],
    "e2e/**/*.ts": [
      "biome check --write --no-errors-on-unmatched",
      "biome check --error-on-warnings --no-errors-on-unmatched"
    ],
    "scripts/{clean-build,e2e}.cjs": [
      "biome check --write --no-errors-on-unmatched",
      "biome check --error-on-warnings --no-errors-on-unmatched"
    ],
    "drizzle.config.ts": [
      "biome check --write --no-errors-on-unmatched",
      "biome check --error-on-warnings --no-errors-on-unmatched"
    ]
  }
}
