<!doctype html>
<html lang="es" data-theme="light">
<%- include("partials/admin-head", { pageTitle }) %>

	<body class="h-dvh overflow-hidden bg-base-200 text-base-content">
		<main class="grid h-dvh grid-rows-[clamp(8rem,28dvh,15rem)_minmax(0,1fr)] md:grid-cols-[minmax(0,1.15fr)_minmax(24rem,.85fr)] md:grid-rows-1">
			<section class="relative min-h-0 overflow-hidden">
				<img
					src="/hero.webp"
					alt="Vicuñas en su entorno natural"
					class="absolute inset-0 h-full w-full object-cover"
				/>
				<div class="absolute inset-0 bg-linear-to-t from-neutral/80 via-neutral/20 to-transparent"></div>
				<div class="absolute inset-x-0 bottom-0 p-5 text-neutral-content sm:p-8 lg:p-16">
					<p class="text-xs font-bold uppercase tracking-[.3em] text-accent">ANMVB</p>
					<p class="mt-2 text-3xl font-semibold sm:text-4xl lg:mt-3 lg:text-5xl">vicugna app</p>
				</div>
			</section>

			<section class="flex min-h-0 items-center justify-center bg-base-100 px-6 py-4 sm:px-12 sm:py-6 lg:py-8">
				<div class="w-full max-w-lg">
					<p class="hidden text-xs font-bold uppercase tracking-[.3em] text-primary md:block">ANMVB · Vicugna App</p>
					<h1 class="font-serif text-4xl leading-tight text-base-content sm:text-5xl lg:text-6xl">
						Registro de campo, incluso sin conexión
					</h1>
					<p class="mt-3 max-w-md text-sm leading-6 text-base-content/65 sm:mt-5 sm:text-base">
						La aplicación móvil para registrar el manejo de vicuñas y sincronizar la información de los permisos asignados.
					</p>

					<div class="mt-5 flex flex-col gap-3 sm:mt-7 sm:flex-row">
						<a
							href="<%= androidDownloadUrl %>"
							class="btn btn-primary sm:flex-1"
							aria-describedby="android-installation-note"
						>
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M12 15V3" />
								<path d="m7 10 5 5 5-5" />
								<path d="M5 21h14" />
							</svg>
							Descargar para Android
						</a>
						<a href="/admin/login" class="btn btn-outline btn-primary sm:flex-1">
							Administración
						</a>
					</div>

					<p id="android-installation-note" class="mt-3 text-xs leading-5 text-base-content/55">
						Instalación directa mediante archivo APK. Android puede solicitar autorización para instalar aplicaciones externas.
					</p>
				</div>
			</section>
		</main>
	</body>
</html>
