<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="application-version" content="<%= appVersion %>" />
		<title><%= pageTitle %></title>
		<link rel="icon" type="image/png" href="<%= faviconPath %>" />
		<link rel="stylesheet" href="/site.css" />
	</head>
	<body>
		<main class="landing">
			<section class="landing__hero">
				<img src="/hero.webp" alt="Vicuñas en su entorno natural" class="landing__image" />
				<div class="landing__shade"></div>
				<div class="landing__brand">
					<p class="eyebrow eyebrow--light">ANMVB</p>
					<p class="landing__app-name">vicugna app</p>
				</div>
			</section>

			<section class="landing__content">
				<div class="landing__copy">
					<p class="eyebrow landing__desktop-brand">ANMVB · Vicugna App</p>
					<h1>Trabaja en el campo, sin depender de la señal</h1>
					<p class="landing__description">Registra el manejo de vicuñas, con o sin conexión.</p>

					<div class="landing__actions">
						<a href="<%= androidDownloadUrl %>" class="button button--primary" aria-describedby="android-installation-note">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M12 15V3" />
								<path d="m7 10 5 5 5-5" />
								<path d="M5 21h14" />
							</svg>
							Descargar para Android
						</a>
						<a href="/admin/login" class="button button--outline">Administración</a>
					</div>

					<p id="android-installation-note" class="landing__note">
						Instalación directa mediante archivo APK. Android puede solicitar autorización para instalar aplicaciones externas.
					</p>
				</div>
			</section>
		</main>
	</body>
</html>
