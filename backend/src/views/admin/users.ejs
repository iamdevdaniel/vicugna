<!doctype html>
<html lang="es" data-theme="light">
<%- include("../partials/admin-head", { pageTitle }) %>

	<body class="h-screen overflow-hidden bg-base-200 text-base-content">
		<main class="mx-auto flex h-full min-h-0 max-w-6xl flex-col px-5 py-8"
			x-data="{ isCreateModalOpen: false, activeUsersTab: window.location.hash === '#admins' ? 'admins' : 'users' }"
			@hashchange.window="activeUsersTab = window.location.hash === '#admins' ? 'admins' : 'users'"
			@user-created.window="isCreateModalOpen = false; $refs.createUserForm.reset(); $refs.createUserForm.elements.password.value = ''">
			<header class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div>
					<p class="mb-1 text-xs font-bold uppercase tracking-wide text-slate-500">
						Administración Vicugna
					</p>
					<div class="flex items-center gap-3">
						<h1 class="text-3xl font-semibold text-slate-900">Usuarios</h1>
						<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary text-primary-content">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
								<path d="M16 3.128a4 4 0 0 1 0 7.744" />
								<path d="M22 21v-2a4 4 0 0 0-3-3.87" />
								<circle cx="9" cy="7" r="4" />
							</svg>
						</div>
					</div>
					<p class="mt-2 text-sm text-slate-500"><%= adminUser.fullName %></p>
				</div>

				<div class="flex items-center gap-3">
					<a href="/admin/mission-control"
						class="btn btn-outline btn-primary">
						Inicio
					</a>
				</div>
			</header>

			<div class="modal modal-open bg-neutral/50"
				x-show="isCreateModalOpen" x-cloak>
				<button type="button" class="modal-backdrop" aria-label="Cerrar modal"
					@click="isCreateModalOpen = false"></button>

				<section
					class="modal-box">
					<div class="flex items-start justify-between gap-4">
						<div>
							<h2 class="text-lg font-semibold text-slate-900">Nuevo usuario</h2>
						</div>
						<button type="button"
							class="btn btn-ghost btn-sm"
							@click="isCreateModalOpen = false">
							Cerrar
						</button>
					</div>

					<form x-ref="createUserForm" class="mt-5 flex flex-col gap-4" hx-post="/admin/users"
						autocomplete="off"
						hx-target="#create-user-modal-message" hx-swap="innerHTML">
						<div id="create-user-modal-message"></div>

						<label class="form-control">
							<span class="label-text mb-2 font-semibold">Nombres</span>
							<input
								class="input input-bordered w-full"
								autocomplete="off"
								required
								type="text" name="firstName" />
						</label>

						<label class="form-control">
							<span class="label-text mb-2 font-semibold">Apellido paterno</span>
							<input
								class="input input-bordered w-full"
								autocomplete="off"
								required
								type="text" name="paternalLastName" />
						</label>

						<label class="form-control">
							<span class="label-text mb-2 font-semibold">Apellido materno</span>
							<input
								class="input input-bordered w-full"
								autocomplete="off"
								required
								type="text" name="maternalLastName" />
						</label>

						<label class="form-control">
							<span class="label-text mb-2 font-semibold">Telefono</span>
							<input
								class="input input-bordered w-full"
								autocomplete="off"
								type="tel" name="phoneNumber" />
						</label>

						<label class="form-control">
							<span class="label-text mb-2 flex items-center justify-between gap-3 font-semibold">
								Correo
								<span class="text-xs font-medium text-base-content/50">Opcional</span>
							</span>
							<input
								class="input input-bordered w-full"
								autocomplete="off"
								type="email" name="email" />
						</label>

						<%- include("../partials/users-password-field", { suggestedPassword: "" }) %>

							<div class="flex justify-end gap-3 pt-2">
								<button type="button"
									class="btn btn-ghost"
									@click="isCreateModalOpen = false">
									Cancelar
								</button>
								<button type="submit"
									class="btn btn-primary">
									<span class="htmx-request:hidden">Crear usuario</span>
									<span class="htmx-indicator">Guardando...</span>
								</button>
							</div>
					</form>
				</section>
			</div>
			<div class="mt-6 flex min-h-0 flex-1 items-start">
				<%- include("../partials/users-list", { users }) %>
			</div>
				<div id="toast-container" class="pointer-events-none fixed bottom-5 right-5 z-50 w-full max-w-md px-4 sm:px-0"></div>
		</main>
		<script src="/vendor/jdenticon.min.js"></script>
		<script>
			document.addEventListener("DOMContentLoaded", () => {
				window.jdenticon?.update("[data-jdenticon-value]")
			})

			document.body.addEventListener("htmx:afterSwap", () => {
				window.jdenticon?.update("[data-jdenticon-value]")
			})
		</script>
	</body>

</html>
