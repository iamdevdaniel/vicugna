<%
	const regularUsers = users.filter((user) => user.role === "user")
	const adminUsers = users.filter((user) => user.role === "admin")
%>

<section id="users-page" <% if (typeof useOobSwap !== "undefined" && useOobSwap) { %>hx-swap-oob="outerHTML"<% } %> class="card flex max-h-full min-h-0 w-full flex-col overflow-hidden bg-base-100 shadow">
	<div class="shrink-0 border-b border-base-300 px-5 pt-5">
		<div class="flex min-h-12 items-center justify-between gap-4">
			<h2 class="text-lg font-semibold text-slate-900">Usuarios registrados</h2>
			<button type="button"
				class="btn btn-primary"
				x-show="activeUsersTab === 'users'"
				x-cloak
				@click="$refs.createUserForm.reset(); $refs.createUserForm.elements.password.value = ''; document.getElementById('create-user-modal-message').innerHTML = ''; isCreateModalOpen = true">
				Nuevo encargado
			</button>
		</div>

		<nav class="tabs tabs-border mt-5" aria-label="Tipos de usuario">
			<a href="#users"
				class="tab"
				:class="activeUsersTab === 'users' ? 'tab-active' : ''"
				@click="activeUsersTab = 'users'">
				Encargados
				<span class="ml-2 inline-flex items-center gap-1 rounded-full bg-accent/25 px-2 py-1 text-xs font-medium text-neutral"
					x-show="activeUsersTab === 'users'">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
						<path d="M16 3.128a4 4 0 0 1 0 7.744" />
						<path d="M22 21v-2a4 4 0 0 0-3-3.87" />
						<circle cx="9" cy="7" r="4" />
					</svg>
					<%= regularUsers.length %>
				</span>
			</a>
			<a href="#admins"
				class="tab"
				:class="activeUsersTab === 'admins' ? 'tab-active' : ''"
				@click="activeUsersTab = 'admins'">
				Administradores
				<span class="ml-2 inline-flex items-center gap-1 rounded-full bg-accent/25 px-2 py-1 text-xs font-medium text-neutral"
					x-show="activeUsersTab === 'admins'">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
						<path d="M16 3.128a4 4 0 0 1 0 7.744" />
						<path d="M22 21v-2a4 4 0 0 0-3-3.87" />
						<circle cx="9" cy="7" r="4" />
					</svg>
					<%= adminUsers.length %>
				</span>
			</a>
		</nav>
	</div>

	<div class="min-h-0 overflow-y-auto overscroll-contain" x-show="activeUsersTab === 'users'">
		<%- include("./users-list-panel", { users: regularUsers, emptyMessage: "No hay encargados creados." }) %>
	</div>

	<div class="min-h-0 overflow-y-auto overscroll-contain" x-show="activeUsersTab === 'admins'">
		<%- include("./users-list-panel", { users: adminUsers, emptyMessage: "No hay administradores creados." }) %>
	</div>
</section>
