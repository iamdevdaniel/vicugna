<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta name="application-version" content="<%= appVersion %>" />
	<title>
		<%= pageTitle %>
	</title>
	<script>
		const savedTheme = localStorage.getItem("vicugna-admin-theme")
		document.documentElement.dataset.theme = savedTheme === "dark" ? "dark" : "light"
		window.toggleAdminTheme = () => {
			const theme = document.documentElement.dataset.theme === "dark" ? "light" : "dark"
			document.documentElement.dataset.theme = theme
			localStorage.setItem("vicugna-admin-theme", theme)
		}
	</script>
	<link rel="icon" type="image/png" href="<%= faviconPath %>" />
	<link rel="stylesheet" href="/admin.css" />
	<script defer src="/vendor/htmx.min.js"></script>
	<script defer src="/vendor/alpine.min.js"></script>
	<script>console.info("Vicugna backend v<%= appVersion %>")</script>
</head>
