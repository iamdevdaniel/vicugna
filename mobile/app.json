{
  "expo": {
    "name": "vicugna",
    "slug": "vicugna",
    "version": "1.0.0",
    "runtimeVersion": "1.0",
    "updates": {
      "url": "https://u.expo.dev/a0de7245-1ed6-44cd-9495-86ecd499a78f"
    },
    "icon": "./assets/images/vicugna-logo-day.png",
    "orientation": "portrait",
    "scheme": "vicugna",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.maydanachi.vicugna"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/vicugna-splash-title.png",
          "imageWidth": 192,
          "resizeMode": "contain",
          "backgroundColor": "#e9d8be"
        }
      ],
      [
        "@morrowdigital/watermelondb-expo-plugin",
        {
          "disableJsi": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "pickFirst": [
                "**/libc++_shared.so"
              ]
            }
          }
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "ignoreFiles": [
          "**/*utils*",
          "**/*theme*",
          "**/util*"
        ]
      },
      "eas": {
        "projectId": "a0de7245-1ed6-44cd-9495-86ecd499a78f"
      }
    },
    "owner": "maydanachi"
  }
}
