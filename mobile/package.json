{
  "name": "vicugna",
  "main": "expo-router/entry",
  "version": "1.2.0",
  "scripts": {
    "tscheck": "tsc --noEmit",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "e2e:build": "expo prebuild --platform android --no-install && detox build -C ./e2e/detox.config.js -c android.attached.debug",
    "e2e:happy": "detox test -C ./e2e/detox.config.js -c android.attached.debug ./e2e/happy-path.test.js",
    "e2e:validation": "detox test -C ./e2e/detox.config.js -c android.attached.debug ./e2e/validation.test.js",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint-fix": "npx biome check ./app ./components ./database ./assets ./definitions ./utils ./e2e --write",
    "prepare": "cd .. && husky"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.2.1",
    "@morrowdigital/watermelondb-expo-plugin": "^2.3.3",
    "@nozbe/watermelondb": "^0.28.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@shopify/react-native-skia": "2.2.12",
    "decimal.js": "^10.6.0",
    "expo": "~54.0.36",
    "expo-blur": "~15.0.7",
    "expo-build-properties": "~1.0.9",
    "expo-constants": "~18.0.10",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.10",
    "expo-linking": "~8.0.12",
    "expo-network": "~8.0.8",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.11",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.8",
    "expo-updates": "~29.0.18",
    "expo-web-browser": "~15.0.11",
    "jdenticon": "^3.3.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.62.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-paper": "^5.14.5",
    "react-native-paper-dates": "^0.23.16",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "yup": "^1.7.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@biomejs/biome": "2.1.4",
    "@types/react": "~19.1.10",
    "detox": "^20.51.4",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@nozbe/simdjson"
        ]
      }
    }
  },
  "private": true,
  "lint-staged": {
    "{app,components,database,assets,definitions,utils,e2e}/**/*.{ts,tsx,js,mjs}": [
      "biome check --write --no-errors-on-unmatched",
      "biome check --error-on-warnings --no-errors-on-unmatched"
    ]
  }
}
