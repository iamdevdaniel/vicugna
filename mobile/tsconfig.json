{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"experimentalDecorators": true,
		"strict": true,
		"paths": {
			"@app/*": ["./app/*"],
			"@definitions/*": ["./definitions/*"],
			"@assets/*": ["./assets/*"],
			"@utils/*": ["./utils/*"],
			"@api": ["./api/index"],
			"@database": ["./database/index"],
			"@database/web": ["./database/index.web"],
			"@components": ["./components/index"],
			"@components/*": ["./components/*"],
			"@hooks": ["./hooks/index"],
			"@hooks/web": ["./hooks/index.web"],
			"@screens/*": ["./screens/*"],
			"@vicugna/shared": ["../shared/types.d.ts"],
			"@vicugna/shared/*": ["../shared/*"]
		}
	},
	"include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
