---
import { routes, type Language, type RouteName } from "../lib/routes"
import { commonContent } from "../lib/content"

type Props = {
	language: Language
	page: RouteName
}

const { language, page } = Astro.props
const pageRoutes = routes[page]
const content = commonContent[language]
---

<header class="grid gap-5 border-b border-earth/20 py-5 sm:grid-cols-[auto_1fr_auto] sm:items-center sm:gap-8">
	<a
		href={routes.home[language]}
		aria-label={`${content.navigation.home} — ANMVB`}
		class="text-sm font-bold tracking-[0.24em]"
	>
		ANMVB
	</a>

	<nav class="order-3 flex flex-wrap gap-x-5 gap-y-2 text-xs font-semibold uppercase tracking-[0.12em] sm:order-0 sm:justify-center">
		{Object.entries(routes).map(([name, localizedRoute]) => (
			<a class:list={["transition-colors hover:text-clay", { "text-clay": page === name }]} href={localizedRoute[language]}>
				{content.navigation[name as RouteName]}
			</a>
		))}
	</nav>

	<nav aria-label={content.languageLabel} class="flex gap-2 text-xs font-bold tracking-widest">
		<a class:list={["hover:text-clay", { "text-clay": language === "es" }]} href={pageRoutes.es} lang="es">ES</a>
		<span aria-hidden="true">/</span>
		<a class:list={["hover:text-clay", { "text-clay": language === "en" }]} href={pageRoutes.en} lang="en">EN</a>
	</nav>
</header>
