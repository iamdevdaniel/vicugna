---
import { routes, type Language, type RouteName } from "../lib/routes"
import { translations } from "../lib/content"

type Props = {
	language: Language
	page: RouteName
}

const { language, page } = Astro.props
const pageRoutes = routes[page]
const text = translations[language]
---

<header class="sticky top-0 z-50 grid gap-5 border-b border-earth/20 bg-canvas py-5 sm:grid-cols-[auto_1fr_auto] sm:items-center sm:gap-8">
	<a
		href={routes.home[language]}
		aria-label={`${text["navigation.home"]} — ANMVB`}
		class="text-sm font-bold tracking-[0.24em]"
	>
		ANMVB
	</a>

	<nav class="order-3 flex flex-wrap gap-x-5 gap-y-2 text-xs font-semibold uppercase tracking-[0.12em] sm:order-0 sm:justify-center">
		<a class:list={["transition-colors hover:text-clay", { "text-clay": page === "home" }]} href={routes.home[language]}>{text["navigation.home"]}</a>
		<a class:list={["transition-colors hover:text-clay", { "text-clay": page === "fiber" }]} href={routes.fiber[language]}>{text["navigation.fiber"]}</a>
		<a class:list={["transition-colors hover:text-clay", { "text-clay": page === "organization" }]} href={routes.organization[language]}>{text["navigation.organization"]}</a>
		<a class:list={["transition-colors hover:text-clay", { "text-clay": page === "contact" }]} href={routes.contact[language]}>{text["navigation.contact"]}</a>
	</nav>

	<nav aria-label={text["common.languageLabel"]} class="flex gap-2 text-xs font-bold tracking-widest">
		<a class:list={["hover:text-clay", { "text-clay": language === "es" }]} href={pageRoutes.es} lang="es">ES</a>
		<span aria-hidden="true">/</span>
		<a class:list={["hover:text-clay", { "text-clay": language === "en" }]} href={pageRoutes.en} lang="en">EN</a>
	</nav>
</header>
