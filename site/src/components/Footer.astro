---
import { links, translations } from "../lib/content"
import { routes, type Language } from "../lib/routes"

type Props = { language: Language }

const { language } = Astro.props
const text = translations[language]
---

<footer class="border-t border-earth/20 py-10 sm:py-14">
	<div class="grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
		<div>
			<p class="font-serif text-2xl sm:text-3xl">{text["footer.title"]}</p>
			<p class="mt-3 max-w-xl text-sm text-earth/65">{text["footer.text"]}</p>
			<p class="mt-5 max-w-2xl text-xs leading-5 text-earth/50">{text["footer.rights"]}</p>
		</div>
		<div class="flex flex-col items-start gap-5 md:items-end">
			<a href={routes.contact[language]} class="text-xs font-bold uppercase tracking-[0.18em] underline decoration-clay underline-offset-8">
				{text["navigation.contact"]}
			</a>
			<a href={links.app} class="border border-earth/25 px-4 py-3 text-xs font-bold uppercase tracking-[0.16em] transition-colors hover:border-clay hover:text-clay">
				{text["footer.appAccess"]}
			</a>
		</div>
	</div>
</footer>
