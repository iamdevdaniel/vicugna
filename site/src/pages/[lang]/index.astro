---
import BaseLayout from "../../layouts/BaseLayout.astro"
import { images, translations } from "../../lib/content"
import { routes, type Language } from "../../lib/routes"

export function getStaticPaths() {
	return [
		{ params: { lang: "es" }, props: { lang: "es" } },
		{ params: { lang: "en" }, props: { lang: "en" } },
	]
}

const { lang } = Astro.props as { lang: Language }
const text = translations[lang]
---

<BaseLayout language={lang} page="home" title={text["home.pageTitle"]} description={text["home.hero.body"]}>
	<section class="relative mt-6 min-h-[72vh] overflow-hidden bg-earth sm:mt-8">
		<img
			src={images["home.hero"]}
			alt={text["common.imageAlt"]}
			class="absolute inset-0 h-full w-full translate-x-[25%] scale-[1.1] object-cover opacity-65"
		/>
		<div
			class="absolute inset-0 bg-[linear-gradient(to_right,#2a1c11_20%,rgba(42,28,17,0.7)_40%,transparent_65%)]"
		></div>
		<div class="relative flex min-h-[72vh] max-w-4xl flex-col justify-end px-6 py-12 text-canvas sm:px-10 sm:py-16 lg:px-16">
			<p class="eyebrow text-sand">{text["home.hero.eyebrow"]}</p>
			<h1 class="mt-5 font-serif text-5xl leading-[0.98] sm:text-7xl lg:text-8xl">{text["home.hero.title"]}</h1>
			<p class="mt-7 max-w-2xl text-base leading-7 text-canvas/80 sm:text-lg">{text["home.hero.body"]}</p>
			<div class="mt-8 flex flex-wrap gap-4">
				<a class="button-primary" href={routes.fiber[lang]}>{text["home.hero.primaryAction"]}</a>
				<a class="button-light" href={routes.contact[lang]}>{text["home.hero.secondaryAction"]}</a>
			</div>
		</div>
	</section>

	<section class="grid gap-10 py-20 lg:grid-cols-[0.9fr_1.1fr] lg:gap-24 lg:py-28">
		<div>
			<p class="eyebrow">{text["home.intro.eyebrow"]}</p>
			<h2 class="section-title">{text["home.intro.title"]}</h2>
		</div>
		<div>
			<p class="section-subtitle">{text["home.intro.body"]}</p>
		</div>
	</section>

	<section class="grid border-y border-earth/20 md:grid-cols-3">
		<article class="py-10 md:px-8">
			<h3 class="font-serif text-3xl">{text["home.values.1.title"]}</h3>
			<p class="mt-4 font-medium leading-6">{text["home.values.1.body"]}</p>
		</article>
		<article class="border-t border-earth/20 py-10 md:border-l md:border-t-0 md:px-8">
			<h3 class="font-serif text-3xl">{text["home.values.2.title"]}</h3>
			<p class="mt-4 font-medium leading-6">{text["home.values.2.body"]}</p>
		</article>
		<article class="border-t border-earth/20 py-10 md:border-l md:border-t-0 md:px-8">
			<h3 class="font-serif text-3xl">{text["home.values.3.title"]}</h3>
			<p class="mt-4 font-medium leading-6">{text["home.values.3.body"]}</p>
		</article>
	</section>

	<section class="grid gap-10 py-20 sm:py-28 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
		<img src={images["home.feature"]} alt={text["common.imageAlt"]} loading="lazy" class="aspect-4/3 h-full w-full object-cover" />
		<div class="lg:px-10">
			<p class="eyebrow">{text["home.feature.eyebrow"]}</p>
			<h2 class="section-title">{text["home.feature.title"]}</h2>
			<p class="section-subtitle">{text["home.feature.body"]}</p>
			<a class="mt-8 inline-block border-b-2 border-clay pb-[0.4rem] text-[0.7rem] font-bold uppercase tracking-[0.16em]" href={routes.fiber[lang]}>{text["home.feature.action"]}</a>
		</div>
	</section>

	<section class="mb-20 bg-sage px-6 py-16 text-canvas sm:px-12 sm:py-20 lg:grid lg:grid-cols-[1fr_auto] lg:items-end lg:gap-12">
		<div>
			<h2 class="max-w-4xl font-serif text-4xl leading-tight sm:text-6xl">{text["home.closing.title"]}</h2>
			<p class="mt-5 max-w-2xl text-canvas/75">{text["home.closing.body"]}</p>
		</div>
		<a class="button-light mt-8 lg:mt-0" href={routes.contact[lang]}>{text["home.closing.action"]}</a>
	</section>
</BaseLayout>
