---
import "../../styles/global.css"
import Header from "../../components/Header.astro"
import type { Language } from "../../lib/routes"

const translations = {
	es: {
		title: "Fibra de vicuña de Bolivia",
		description: "Sitio institucional de ANMVB.",
	},
	en: {
		title: "Bolivian vicuña fiber",
		description: "ANMVB institutional website.",
	},
} as const

export function getStaticPaths() {
	return [
		{ params: { lang: "es" }, props: { lang: "es" } },
		{ params: { lang: "en" }, props: { lang: "en" } },
	]
}

const { lang } = Astro.props as { lang: Language }
const text = translations[lang]
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>ANMVB</title>
	</head>
	<body>
		<main class="grid min-h-screen grid-rows-[auto_1fr] px-6 py-6 sm:px-12">
			<Header language={lang} page="home" />

			<section class="flex max-w-3xl flex-col justify-center py-20">
				<h1 class="font-serif text-5xl leading-tight sm:text-7xl">{text.title}</h1>
				<p class="mt-6 text-base text-earth/75 sm:text-lg">{text.description}</p>
			</section>
		</main>
	</body>
</html>
