---
import Footer from "../components/Footer.astro"
import Header from "../components/Header.astro"
import type { Language, RouteName } from "../lib/routes"
import "../styles/global.css"

type Props = {
	language: Language
	page: RouteName
	title: string
	description: string
}

const { language, page, title, description } = Astro.props
---

<!doctype html>
<html lang={language}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<title>{title} | ANMVB</title>
	</head>
	<body>
		<div class="mx-auto min-h-screen max-w-[1600px] px-5 sm:px-8 lg:px-12">
			<Header language={language} page={page} />
			<main><slot /></main>
			<Footer language={language} />
		</div>
	</body>
</html>
